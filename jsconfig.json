{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["*.js", "docs/**/*.js", "scripts/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", ".git", ".mimosa", ".zcode", ".claude", ".dsh-acl-repair"]
}
